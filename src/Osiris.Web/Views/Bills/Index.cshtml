@model BillsIndexViewModel

@{
    ViewData["Title"] = "Contas a pagar";
    Layout = "_AuthenticatedLayout";
    var monthOptions = BrazilMonths.MonthSelectList(Model.Month);
    var yearOptions = BrazilMonths.YearSelectList(Model.Year);
    var errorMessage = TempData["BillsErrorMessage"] as string;
    var today = BrazilDates.Today();
}

<section class="space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <p class="text-sm font-medium text-amber-700 dark:text-amber-400">Financeiro</p>
            <h2 class="mt-2 text-2xl font-semibold text-slate-950 dark:text-slate-100">Contas a pagar</h2>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Obrigações fora do cartão, como aluguel, internet, escola e boletos.</p>
        </div>

        <a asp-action="Create" class="inline-flex h-10 items-center justify-center rounded-md bg-slate-950 dark:bg-amber-500 dark:text-slate-950 dark:hover:bg-amber-400 px-4 text-sm font-medium text-white transition hover:bg-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2">
            Nova conta
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="rounded-md border border-red-200 dark:border-red-500/30 bg-red-50 dark:bg-red-500/10 px-4 py-3 text-sm text-red-700 dark:text-red-400">
            @errorMessage
        </div>
    }

    <form asp-action="Index" method="get" class="flex flex-wrap items-end gap-3 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-sm">
        <div>
            <label for="month" class="block text-sm font-medium text-slate-700 dark:text-slate-300">Mês</label>
            <select id="month" name="month" class="mt-1 block h-11 w-44 rounded-md border border-slate-300 dark:border-slate-700 px-3 text-sm outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-200">
                @foreach (var option in monthOptions)
                {
                    <option value="@option.Value" selected="@option.Selected">@option.Text</option>
                }
            </select>
        </div>
        <div>
            <label for="year" class="block text-sm font-medium text-slate-700 dark:text-slate-300">Ano</label>
            <select id="year" name="year" class="mt-1 block h-11 w-32 rounded-md border border-slate-300 dark:border-slate-700 px-3 text-sm outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-200">
                @foreach (var option in yearOptions)
                {
                    <option value="@option.Value" selected="@option.Selected">@option.Text</option>
                }
            </select>
        </div>
        <button type="submit" class="inline-flex h-11 items-center justify-center rounded-md border border-slate-300 dark:border-slate-700 px-4 text-sm font-medium text-slate-700 dark:text-slate-300 transition hover:bg-slate-50 dark:hover:bg-slate-800">
            Filtrar
        </button>
    </form>

    @if (Model.Bills.Count == 0)
    {
        <div class="rounded-lg border border-dashed border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-6 py-12 text-center shadow-sm">
            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-amber-50 dark:bg-amber-500/10 text-amber-700 dark:text-amber-400">
                <i class="ph ph-receipt text-3xl" aria-hidden="true"></i>
            </div>
            <h3 class="mt-4 text-base font-semibold text-slate-950 dark:text-slate-100">Nenhuma conta em @BrazilMonths.MonthName(Model.Month) de @Model.Year</h3>
            <p class="mx-auto mt-2 max-w-md text-sm text-slate-600 dark:text-slate-300">Cadastre contas fora do cartão, como aluguel, internet, escola, academia ou assinaturas, para acompanhar os vencimentos do mês.</p>
            <div class="mt-6">
                <a asp-action="Create" class="inline-flex h-10 items-center justify-center rounded-md bg-slate-950 dark:bg-amber-500 dark:text-slate-950 dark:hover:bg-amber-400 px-4 text-sm font-medium text-white transition hover:bg-slate-800">
                    Nova conta
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="overflow-hidden rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
            <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-800">
                <thead class="bg-slate-50 dark:bg-slate-800">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Descrição</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Categoria</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Vencimento</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Valor</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Situação</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Ações</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 dark:divide-slate-800 bg-white dark:bg-slate-900">
                    @foreach (var bill in Model.Bills)
                    {
                        <tr>
                            <td class="px-4 py-3">
                                <a asp-action="Details" asp-route-id="@bill.Id" class="text-sm font-medium text-slate-950 dark:text-slate-100 hover:text-amber-700">@bill.Description</a>
                            </td>
                            <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-300">
                                @if (string.IsNullOrWhiteSpace(bill.CategoryName))
                                {
                                    <span class="text-slate-400 dark:text-slate-500">Sem categoria</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-2">
                                        @if (!string.IsNullOrWhiteSpace(bill.CategoryColor))
                                        {
                                            <span class="h-3 w-3 rounded-full border border-slate-200 dark:border-slate-800" style="background-color: @bill.CategoryColor"></span>
                                        }
                                        @bill.CategoryName
                                    </span>
                                }
                            </td>
                            <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-300">@bill.DueDate.ToString("dd/MM/yyyy")</td>
                            <td class="px-4 py-3 text-right text-sm font-medium text-slate-950 dark:text-slate-100">@bill.Amount.ToBrl()</td>
                            <td class="px-4 py-3">
                                <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium @bill.Status.ToBadgeClasses()">
                                    @bill.Status.ToDisplayName()
                                </span>
                            </td>
                            <td class="px-4 py-3">
                                <div class="flex flex-wrap justify-end gap-2">
                                    @if (bill.PaidAt is null)
                                    {
                                        <form asp-action="Pay" asp-route-id="@bill.Id" method="post">
                                            <input type="hidden" name="returnTo" value="index" />
                                            <input type="hidden" name="PaidAt" value="@today.ToString("yyyy-MM-dd")" />
                                            @if (bill.PaymentAccountId is not null)
                                            {
                                                <input type="hidden" name="PaymentAccountId" value="@bill.PaymentAccountId" />
                                            }
                                            <button type="submit" class="inline-flex h-9 items-center rounded-md border border-emerald-300 dark:border-emerald-500/40 px-3 text-sm font-medium text-emerald-700 dark:text-emerald-300 transition hover:bg-emerald-50">Marcar como paga</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Pending" asp-route-id="@bill.Id" method="post">
                                            <input type="hidden" name="returnTo" value="index" />
                                            <button type="submit" class="inline-flex h-9 items-center rounded-md border border-amber-300 dark:border-amber-500/40 px-3 text-sm font-medium text-amber-800 dark:text-amber-300 transition hover:bg-amber-50 dark:hover:bg-amber-500/10">Marcar como pendente</button>
                                        </form>
                                    }
                                    <a asp-action="Edit" asp-route-id="@bill.Id" class="inline-flex h-9 items-center rounded-md border border-slate-300 dark:border-slate-700 px-3 text-sm font-medium text-slate-700 dark:text-slate-300 transition hover:bg-slate-50 dark:hover:bg-slate-800">Editar</a>
                                    <a asp-action="Delete" asp-route-id="@bill.Id" class="inline-flex h-9 items-center rounded-md border border-red-300 dark:border-red-500/40 px-3 text-sm font-medium text-red-700 dark:text-red-400 transition hover:bg-red-50 dark:hover:bg-red-500/10">Excluir</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
