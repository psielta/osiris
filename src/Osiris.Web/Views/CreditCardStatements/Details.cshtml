@model CreditCardStatementDetailsDto

@{
    var referenceLabel = CreditCardStatementStatusViewExtensions.ToReferenceLabel(Model.ReferenceMonth, Model.ReferenceYear);
    ViewData["Title"] = $"Fatura {referenceLabel}";
    Layout = "_AuthenticatedLayout";
    var today = BrazilDates.Today();
    var isOverdue = Model.Status == CreditCardStatementStatus.Overdue;
    var isDueSoon = !isOverdue
        && Model.OpenBalance > 0m
        && Model.DueDate >= today
        && Model.DueDate <= today.AddDays(7);
    var isPartiallyPaid = Model.Status == CreditCardStatementStatus.PartiallyPaid;
}

<section class="space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <p class="text-sm font-medium text-amber-700 dark:text-amber-400">Financeiro</p>
            <h2 class="mt-2 text-2xl font-semibold text-slate-950 dark:text-slate-100">Fatura @referenceLabel — @Model.CreditCardName</h2>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
                <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium @Model.Status.ToBadgeClasses()">@Model.Status.ToDisplayName()</span>
            </p>
        </div>
        <div class="flex flex-wrap gap-3">
            @if (Model.OpenBalance > 0m)
            {
                <a asp-action="Pay" asp-route-cardId="@Model.CreditCardId" asp-route-id="@Model.Id" asp-route-full="true" class="inline-flex h-10 items-center justify-center rounded-md bg-slate-950 dark:bg-amber-500 dark:text-slate-950 dark:hover:bg-amber-400 px-4 text-sm font-medium text-white transition hover:bg-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2">Pagar valor total</a>
                <a asp-action="Pay" asp-route-cardId="@Model.CreditCardId" asp-route-id="@Model.Id" class="inline-flex h-10 items-center justify-center rounded-md border border-slate-300 dark:border-slate-700 px-4 text-sm font-medium text-slate-700 dark:text-slate-300 transition hover:bg-slate-50 dark:hover:bg-slate-800">Registrar pagamento parcial</a>
            }
            <a asp-action="Index" asp-route-cardId="@Model.CreditCardId" class="inline-flex h-10 items-center justify-center rounded-md border border-slate-300 dark:border-slate-700 px-4 text-sm font-medium text-slate-700 dark:text-slate-300 transition hover:bg-slate-50 dark:hover:bg-slate-800">Todas as faturas</a>
        </div>
    </div>

    @if (isOverdue)
    {
        <div class="flex items-start gap-3 rounded-md border border-red-300 dark:border-red-500/40 bg-red-50 dark:bg-red-500/10 px-4 py-3 text-sm text-red-800 dark:text-red-300">
            <i class="ph ph-warning-circle mt-0.5 text-lg" aria-hidden="true"></i>
            <span>Esta fatura está vencida desde @Model.DueDate.ToString("dd/MM/yyyy") com @Model.OpenBalance.ToBrl() em aberto.</span>
        </div>
    }
    else if (isDueSoon)
    {
        <div class="flex items-start gap-3 rounded-md border border-amber-300 dark:border-amber-500/40 bg-amber-50 dark:bg-amber-500/10 px-4 py-3 text-sm text-amber-800 dark:text-amber-300">
            <i class="ph ph-clock mt-0.5 text-lg" aria-hidden="true"></i>
            <span>Esta fatura vence em breve: @Model.DueDate.ToString("dd/MM/yyyy"), com @Model.OpenBalance.ToBrl() em aberto.</span>
        </div>
    }
    else if (isPartiallyPaid)
    {
        <div class="flex items-start gap-3 rounded-md border border-amber-300 dark:border-amber-500/40 bg-amber-50 dark:bg-amber-500/10 px-4 py-3 text-sm text-amber-800 dark:text-amber-300">
            <i class="ph ph-coins mt-0.5 text-lg" aria-hidden="true"></i>
            <span>Pagamento em andamento: ainda restam @Model.OpenBalance.ToBrl() para quitar esta fatura.</span>
        </div>
    }

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        <div class="rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Total da fatura</p>
            <p class="mt-2 text-xl font-semibold text-slate-950 dark:text-slate-100">@Model.TotalAmount.ToBrl()</p>
        </div>
        <div class="rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Total pago</p>
            <p class="mt-2 text-xl font-semibold text-emerald-700 dark:text-emerald-300">@Model.PaidAmount.ToBrl()</p>
        </div>
        <div class="rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Saldo em aberto</p>
            <p class="mt-2 text-xl font-semibold @(Model.OpenBalance > 0m ? "text-red-600 dark:text-red-400" : "text-slate-950 dark:text-slate-100")">@Model.OpenBalance.ToBrl()</p>
        </div>
        <div class="rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Fechamento</p>
            <p class="mt-2 text-xl font-semibold text-slate-950 dark:text-slate-100">@Model.ClosingDate.ToString("dd/MM/yyyy")</p>
        </div>
        <div class="rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Vencimento</p>
            <p class="mt-2 text-xl font-semibold text-slate-950 dark:text-slate-100">@Model.DueDate.ToString("dd/MM/yyyy")</p>
        </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-2">
        <div class="space-y-3">
            <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Parcelas da fatura</h3>
            @if (Model.InstallmentItems.Count == 0)
            {
                <div class="rounded-lg border border-dashed border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-6 py-10 text-center text-sm text-slate-600 dark:text-slate-300 shadow-sm">
                    Nenhuma parcela nesta fatura.
                </div>
            }
            else
            {
                <div class="overflow-hidden rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
                    <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-800">
                        <thead class="bg-slate-50 dark:bg-slate-800">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Compra</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Parcela</th>
                                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Valor</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200 dark:divide-slate-800 bg-white dark:bg-slate-900">
                            @foreach (var installment in Model.InstallmentItems)
                            {
                                <tr>
                                    <td class="px-4 py-3 text-sm font-medium text-slate-950 dark:text-slate-100">
                                        <a asp-controller="CreditCardPurchases" asp-action="Details" asp-route-cardId="@Model.CreditCardId" asp-route-id="@installment.CreditCardPurchaseId" class="hover:text-amber-700">@installment.PurchaseDescription</a>
                                    </td>
                                    <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-300">@installment.InstallmentNumber de @installment.TotalInstallments</td>
                                    <td class="px-4 py-3 text-right text-sm font-semibold text-slate-950 dark:text-slate-100">@installment.Amount.ToBrl()</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="space-y-3">
            <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Pagamentos</h3>
            @if (Model.Payments.Count == 0)
            {
                <div class="rounded-lg border border-dashed border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-6 py-10 text-center text-sm text-slate-600 dark:text-slate-300 shadow-sm">
                    Nenhum pagamento registrado para esta fatura.
                </div>
            }
            else
            {
                <div class="overflow-hidden rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
                    <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-800">
                        <thead class="bg-slate-50 dark:bg-slate-800">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Data</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Conta</th>
                                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Valor</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200 dark:divide-slate-800 bg-white dark:bg-slate-900">
                            @foreach (var payment in Model.Payments)
                            {
                                <tr>
                                    <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-300">@payment.PaidAt.ToString("dd/MM/yyyy")</td>
                                    <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-300">@(payment.FinancialAccountName ?? "Sem conta")</td>
                                    <td class="px-4 py-3 text-right text-sm font-semibold text-emerald-700 dark:text-emerald-300">@payment.Amount.ToBrl()</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 text-xs text-slate-500 dark:text-slate-400 shadow-sm">
                O pagamento da fatura quita a dívida do cartão e sai do caixa da conta escolhida. Ele não cria uma nova despesa por categoria: o gasto já foi contado quando a compra aconteceu.
            </div>
        </div>
    </div>
</section>
