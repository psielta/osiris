@model CreditCardFormViewModel

@{
    ViewData["Title"] = "Editar cartão";
    Layout = "_AuthenticatedLayout";
}

<section class="mx-auto max-w-2xl space-y-6">
    <div>
        <p class="text-sm font-medium text-amber-700">Financeiro</p>
        <h2 class="mt-2 text-2xl font-semibold text-slate-950">Editar cartão</h2>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="space-y-5 rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
        <div asp-validation-summary="ModelOnly" class="rounded-md bg-red-50 px-3 py-2 text-sm text-red-700"></div>
        <input asp-for="Id" type="hidden" />

        <div>
            <label asp-for="Name" class="block text-sm font-medium text-slate-700"></label>
            <input asp-for="Name" autocomplete="off" class="mt-1 block h-11 w-full rounded-md border border-slate-300 px-3 text-sm outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-200" />
            <span asp-validation-for="Name" class="mt-1 block text-sm text-red-600"></span>
        </div>

        <div>
            <label asp-for="Limit" class="block text-sm font-medium text-slate-700"></label>
            <input asp-for="Limit" type="number" step="0.01" min="0" inputmode="decimal" class="mt-1 block h-11 w-full rounded-md border border-slate-300 px-3 text-sm outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-200" />
            <span asp-validation-for="Limit" class="mt-1 block text-sm text-red-600"></span>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
            <div>
                <label asp-for="ClosingDay" class="block text-sm font-medium text-slate-700"></label>
                <input asp-for="ClosingDay" type="number" min="1" max="31" class="mt-1 block h-11 w-full rounded-md border border-slate-300 px-3 text-sm outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-200" />
                <span asp-validation-for="ClosingDay" class="mt-1 block text-sm text-red-600"></span>
            </div>
            <div>
                <label asp-for="DueDay" class="block text-sm font-medium text-slate-700"></label>
                <input asp-for="DueDay" type="number" min="1" max="31" class="mt-1 block h-11 w-full rounded-md border border-slate-300 px-3 text-sm outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-200" />
                <span asp-validation-for="DueDay" class="mt-1 block text-sm text-red-600"></span>
            </div>
        </div>

        <div>
            <label asp-for="PaymentAccountId" class="block text-sm font-medium text-slate-700"></label>
            <select asp-for="PaymentAccountId" asp-items="Model.PaymentAccountOptions" class="mt-1 block h-11 w-full rounded-md border border-slate-300 px-3 text-sm outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-200">
                <option value="">Sem conta</option>
            </select>
            <p class="mt-1 text-xs text-slate-500">Conta usada por padrão para pagar a fatura. Opcional.</p>
            <span asp-validation-for="PaymentAccountId" class="mt-1 block text-sm text-red-600"></span>
        </div>

        <div class="flex justify-end gap-3">
            <a asp-action="Index" class="inline-flex h-10 items-center justify-center rounded-md border border-slate-300 px-4 text-sm font-medium text-slate-700 transition hover:bg-slate-50">Cancelar</a>
            <button type="submit" class="inline-flex h-10 items-center justify-center rounded-md bg-slate-950 px-4 text-sm font-medium text-white transition hover:bg-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2">Salvar</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
