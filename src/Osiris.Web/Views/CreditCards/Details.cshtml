@model CreditCardDetailsViewModel

@{
    ViewData["Title"] = Model.Card.Name;
    Layout = "_AuthenticatedLayout";
}

<section class="space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <p class="text-sm font-medium text-amber-700 dark:text-amber-400">Financeiro</p>
            <h2 class="mt-2 text-2xl font-semibold text-slate-950 dark:text-slate-100">@Model.Card.Name</h2>
        </div>
        <div class="flex flex-wrap gap-3">
            <a asp-controller="CreditCardPurchases" asp-action="Create" asp-route-cardId="@Model.Card.Id" class="inline-flex h-10 items-center justify-center rounded-md bg-slate-950 dark:bg-amber-500 dark:text-slate-950 dark:hover:bg-amber-400 px-4 text-sm font-medium text-white transition hover:bg-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2">Nova compra</a>
            <a asp-action="Edit" asp-route-id="@Model.Card.Id" class="inline-flex h-10 items-center justify-center rounded-md border border-slate-300 dark:border-slate-700 px-4 text-sm font-medium text-slate-700 dark:text-slate-300 transition hover:bg-slate-50 dark:hover:bg-slate-800">Editar cartão</a>
            <a asp-action="Index" class="inline-flex h-10 items-center justify-center rounded-md border border-slate-300 dark:border-slate-700 px-4 text-sm font-medium text-slate-700 dark:text-slate-300 transition hover:bg-slate-50 dark:hover:bg-slate-800">Voltar</a>
        </div>
    </div>

    @if (!Model.Card.IsActive)
    {
        <div class="rounded-md border border-amber-300 dark:border-amber-500/40 bg-amber-50 dark:bg-amber-500/10 px-4 py-3 text-sm text-amber-800 dark:text-amber-300">
            Este cartão está arquivado. Não é possível registrar novas compras.
        </div>
    }

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Limite</p>
            <p class="mt-2 text-xl font-semibold text-slate-950 dark:text-slate-100">@Model.Card.Limit.ToBrl()</p>
        </div>
        <div class="rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Dia de fechamento</p>
            <p class="mt-2 text-xl font-semibold text-slate-950 dark:text-slate-100">Dia @Model.Card.ClosingDay</p>
        </div>
        <div class="rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Dia de vencimento</p>
            <p class="mt-2 text-xl font-semibold text-slate-950 dark:text-slate-100">Dia @Model.Card.DueDay</p>
        </div>
        <div class="rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Conta de pagamento</p>
            <p class="mt-2 text-xl font-semibold text-slate-950 dark:text-slate-100">@(Model.Card.PaymentAccountName ?? "—")</p>
        </div>
    </div>

    @if (Model.Overview is not null)
    {
        var overview = Model.Overview;
        var usageWidth = Math.Clamp(overview.UsagePercentage, 0m, 100m);
        var usageBarColor = overview.UsagePercentage >= 80m ? "bg-red-500" : overview.UsagePercentage >= 50m ? "bg-amber-500" : "bg-emerald-500";
        <div class="rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm" data-testid="card-limit-overview">
            <div class="grid gap-6 lg:grid-cols-3">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Limite usado</p>
                    <p class="mt-2 text-xl font-semibold text-slate-950 dark:text-slate-100">@overview.UsedLimit.ToBrl()</p>
                    <div class="mt-2 h-2 overflow-hidden rounded-full bg-slate-100 dark:bg-slate-800">
                        <div class="h-full rounded-full @usageBarColor" style="width: @usageWidth.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div>
                    </div>
                    <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">@overview.UsagePercentage.ToString("0.#")% do limite de @Model.Card.Limit.ToBrl()</p>
                </div>
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Limite disponível</p>
                    <p class="mt-2 text-xl font-semibold @(overview.AvailableLimit < 0m ? "text-red-700 dark:text-red-400" : "text-emerald-700 dark:text-emerald-300")">@overview.AvailableLimit.ToBrl()</p>
                    <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Considera o saldo em aberto de todas as faturas</p>
                </div>
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Total parcelado futuro</p>
                    <p class="mt-2 text-xl font-semibold text-slate-950 dark:text-slate-100">@overview.FutureInstallmentsTotal.ToBrl()</p>
                    <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Parcelas em faturas após a fatura atual</p>
                </div>
            </div>

            @if (overview.NextStatement is not null)
            {
                <div class="mt-6 flex flex-col gap-3 border-t border-slate-200 dark:border-slate-800 pt-4 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Próxima fatura — @CreditCardStatementStatusViewExtensions.ToReferenceLabel(overview.NextStatement.ReferenceMonth, overview.NextStatement.ReferenceYear)</p>
                        <p class="mt-1 text-lg font-semibold text-slate-950 dark:text-slate-100">@overview.NextStatement.TotalAmount.ToBrl()</p>
                        <p class="text-sm text-slate-600 dark:text-slate-300">Vence em @overview.NextStatement.DueDate.ToString("dd/MM/yyyy")</p>
                    </div>
                    <a asp-controller="CreditCardStatements" asp-action="Details" asp-route-cardId="@Model.Card.Id" asp-route-id="@overview.NextStatement.Id" class="inline-flex h-10 items-center justify-center rounded-md border border-slate-300 dark:border-slate-700 px-4 text-sm font-medium text-slate-700 dark:text-slate-300 transition hover:bg-slate-50 dark:hover:bg-slate-800">Ver próxima fatura</a>
                </div>
            }
        </div>
    }

    <div class="space-y-3">
        <div class="flex items-center justify-between">
            <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Compras recentes</h3>
            <a asp-controller="CreditCardPurchases" asp-action="Index" asp-route-cardId="@Model.Card.Id" class="text-sm font-medium text-amber-700 dark:text-amber-400 hover:text-amber-800">Ver todas (@Model.TotalPurchases)</a>
        </div>

        @if (Model.RecentPurchases.Count == 0)
        {
            <div class="rounded-lg border border-dashed border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-6 py-10 text-center shadow-sm">
                <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-amber-50 dark:bg-amber-500/10 text-amber-700 dark:text-amber-400">
                    <i class="ph ph-shopping-cart text-2xl" aria-hidden="true"></i>
                </div>
                <h4 class="mt-4 text-base font-semibold text-slate-950 dark:text-slate-100">Nenhuma compra registrada</h4>
                <p class="mx-auto mt-2 max-w-md text-sm text-slate-600 dark:text-slate-300">Registre a primeira compra deste cartão para acompanhar gastos e faturas.</p>
            </div>
        }
        else
        {
            <div class="overflow-hidden rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
                <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-800">
                    <thead class="bg-slate-50 dark:bg-slate-800">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Data</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Descrição</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Categoria</th>
                            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Parcelas</th>
                            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Valor</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 dark:divide-slate-800 bg-white dark:bg-slate-900">
                        @foreach (var purchase in Model.RecentPurchases)
                        {
                            <tr>
                                <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-300">@purchase.PurchaseDate.ToString("dd/MM/yyyy")</td>
                                <td class="px-4 py-3 text-sm font-medium text-slate-950 dark:text-slate-100">
                                    <a asp-controller="CreditCardPurchases" asp-action="Details" asp-route-cardId="@Model.Card.Id" asp-route-id="@purchase.Id" class="hover:text-amber-700">@purchase.Description</a>
                                </td>
                                <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-300">@(purchase.CategoryName ?? "—")</td>
                                <td class="px-4 py-3 text-right text-sm text-slate-600 dark:text-slate-300">@(purchase.Installments)x</td>
                                <td class="px-4 py-3 text-right text-sm font-semibold text-slate-950 dark:text-slate-100">@purchase.TotalAmount.ToBrl()</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (Model.CurrentStatement is not null)
    {
        <div class="rounded-lg border border-amber-200 dark:border-amber-500/30 bg-amber-50/50 dark:bg-amber-500/10 p-6 shadow-sm">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wide text-amber-700 dark:text-amber-400">Fatura atual — @CreditCardStatementStatusViewExtensions.ToReferenceLabel(Model.CurrentStatement.ReferenceMonth, Model.CurrentStatement.ReferenceYear)</p>
                    <p class="mt-2 text-2xl font-semibold text-slate-950 dark:text-slate-100">@Model.CurrentStatement.TotalAmount.ToBrl()</p>
                    <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
                        Em aberto: <span class="font-medium">@Model.CurrentStatement.OpenBalance.ToBrl()</span>
                        · Fecha em @Model.CurrentStatement.ClosingDate.ToString("dd/MM/yyyy")
                        · Vence em @Model.CurrentStatement.DueDate.ToString("dd/MM/yyyy")
                    </p>
                </div>
                <div class="flex flex-wrap items-center gap-3">
                    <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium @Model.CurrentStatement.Status.ToBadgeClasses()">@Model.CurrentStatement.Status.ToDisplayName()</span>
                    <a asp-controller="CreditCardStatements" asp-action="Details" asp-route-cardId="@Model.Card.Id" asp-route-id="@Model.CurrentStatement.Id" class="inline-flex h-10 items-center justify-center rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-4 text-sm font-medium text-slate-700 dark:text-slate-300 transition hover:bg-slate-50 dark:hover:bg-slate-800">Ver fatura atual</a>
                </div>
            </div>
        </div>
    }

    <div class="space-y-3">
        <div class="flex items-center justify-between">
            <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Faturas</h3>
            <a asp-controller="CreditCardStatements" asp-action="Index" asp-route-cardId="@Model.Card.Id" class="text-sm font-medium text-amber-700 dark:text-amber-400 hover:text-amber-800">Ver todas</a>
        </div>

        @if (Model.Statements.Count == 0)
        {
            <div class="rounded-lg border border-dashed border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-6 py-10 text-center shadow-sm">
                <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-amber-50 dark:bg-amber-500/10 text-amber-700 dark:text-amber-400">
                    <i class="ph ph-receipt text-2xl" aria-hidden="true"></i>
                </div>
                <h4 class="mt-4 text-base font-semibold text-slate-950 dark:text-slate-100">Nenhuma fatura ainda</h4>
                <p class="mx-auto mt-2 max-w-md text-sm text-slate-600 dark:text-slate-300">As faturas são criadas automaticamente quando você registra compras no cartão.</p>
            </div>
        }
        else
        {
            <div class="overflow-hidden rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
                <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-800">
                    <thead class="bg-slate-50 dark:bg-slate-800">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Referência</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Fechamento</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Vencimento</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Status</th>
                            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Total</th>
                            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Em aberto</th>
                            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Ações</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 dark:divide-slate-800 bg-white dark:bg-slate-900">
                        @foreach (var statement in Model.Statements)
                        {
                            <tr>
                                <td class="px-4 py-3 text-sm font-medium text-slate-950 dark:text-slate-100">@CreditCardStatementStatusViewExtensions.ToReferenceLabel(statement.ReferenceMonth, statement.ReferenceYear)</td>
                                <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-300">@statement.ClosingDate.ToString("dd/MM/yyyy")</td>
                                <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-300">@statement.DueDate.ToString("dd/MM/yyyy")</td>
                                <td class="px-4 py-3 text-sm">
                                    <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium @statement.Status.ToBadgeClasses()">@statement.Status.ToDisplayName()</span>
                                </td>
                                <td class="px-4 py-3 text-right text-sm font-semibold text-slate-950 dark:text-slate-100">@statement.TotalAmount.ToBrl()</td>
                                <td class="px-4 py-3 text-right text-sm text-slate-600 dark:text-slate-300">@statement.OpenBalance.ToBrl()</td>
                                <td class="px-4 py-3 text-right">
                                    <a asp-controller="CreditCardStatements" asp-action="Details" asp-route-cardId="@Model.Card.Id" asp-route-id="@statement.Id" class="inline-flex h-9 items-center rounded-md border border-slate-300 dark:border-slate-700 px-3 text-sm font-medium text-slate-700 dark:text-slate-300 transition hover:bg-slate-50 dark:hover:bg-slate-800">Ver fatura</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
