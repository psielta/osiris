@model CreditCardDetailsDto

@{
    ViewData["Title"] = Model.Name;
    Layout = "_AuthenticatedLayout";
}

<section class="space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <p class="text-sm font-medium text-amber-700">Financeiro</p>
            <h2 class="mt-2 text-2xl font-semibold text-slate-950">@Model.Name</h2>
        </div>
        <div class="flex flex-wrap gap-3">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="inline-flex h-10 items-center justify-center rounded-md border border-slate-300 px-4 text-sm font-medium text-slate-700 transition hover:bg-slate-50">Editar cartão</a>
            <a asp-action="Index" class="inline-flex h-10 items-center justify-center rounded-md border border-slate-300 px-4 text-sm font-medium text-slate-700 transition hover:bg-slate-50">Voltar</a>
        </div>
    </div>

    @if (!Model.IsActive)
    {
        <div class="rounded-md border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-800">
            Este cartão está arquivado.
        </div>
    }

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Limite</p>
            <p class="mt-2 text-xl font-semibold text-slate-950">@Model.Limit.ToBrl()</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Dia de fechamento</p>
            <p class="mt-2 text-xl font-semibold text-slate-950">Dia @Model.ClosingDay</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Dia de vencimento</p>
            <p class="mt-2 text-xl font-semibold text-slate-950">Dia @Model.DueDay</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Conta de pagamento</p>
            <p class="mt-2 text-xl font-semibold text-slate-950">@(Model.PaymentAccountName ?? "—")</p>
        </div>
    </div>

    <div class="rounded-lg border border-slate-200 bg-white p-6 text-sm text-slate-600 shadow-sm">
        As compras, faturas e pagamentos do cartão serão adicionados em uma próxima fase. Por enquanto, esta tela mostra a configuração do cartão.
    </div>
</section>
