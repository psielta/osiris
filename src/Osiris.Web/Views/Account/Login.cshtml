@model LoginViewModel

@{
    ViewData["Title"] = "Sign in";
}

<div class="mx-auto flex min-h-screen w-full max-w-md items-center px-4 py-10">
    <section class="w-full rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
        <div>
            <div class="flex items-center gap-3">
                <img src="~/images/osiris-logo.svg" alt="Osiris" class="h-14 w-14 shrink-0" asp-append-version="true" />
                <div>
                    <p class="text-sm font-semibold uppercase tracking-wide text-emerald-700">Osiris</p>
                    <h1 class="mt-1 text-2xl font-semibold text-slate-950">Sign in</h1>
                </div>
            </div>
            <p class="mt-2 text-sm text-slate-600">Open your protected dashboard.</p>
        </div>

        <form asp-action="Login" method="post" class="mt-6 space-y-5">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="rounded-md bg-red-50 px-3 py-2 text-sm text-red-700"></div>

            <div>
                <label asp-for="Email" class="block text-sm font-medium text-slate-700"></label>
                <input asp-for="Email" type="email" autocomplete="email" class="mt-1 block h-11 w-full rounded-md border border-slate-300 px-3 text-sm outline-none focus:border-emerald-600 focus:ring-2 focus:ring-emerald-100" />
                <span asp-validation-for="Email" class="mt-1 block text-sm text-red-600"></span>
            </div>

            <div>
                <label asp-for="Password" class="block text-sm font-medium text-slate-700"></label>
                <input asp-for="Password" type="password" autocomplete="current-password" class="mt-1 block h-11 w-full rounded-md border border-slate-300 px-3 text-sm outline-none focus:border-emerald-600 focus:ring-2 focus:ring-emerald-100" />
                <span asp-validation-for="Password" class="mt-1 block text-sm text-red-600"></span>
            </div>

            <div class="flex items-center justify-between gap-4">
                <label class="flex items-center gap-2 text-sm text-slate-700">
                    <input asp-for="RememberMe" class="h-4 w-4 rounded border-slate-300 text-emerald-700 focus:ring-emerald-600" />
                    Remember me
                </label>
                <a asp-action="ForgotPassword" class="text-sm font-medium text-emerald-700 hover:text-emerald-800">Forgot password?</a>
            </div>

            <button type="submit" class="inline-flex h-11 w-full items-center justify-center rounded-md bg-slate-950 px-4 text-sm font-medium text-white transition hover:bg-slate-800">
                Sign in
            </button>
        </form>

        <p class="mt-6 text-center text-sm text-slate-600">
            New here?
            <a asp-action="Register" class="font-medium text-emerald-700 hover:text-emerald-800">Create an account</a>
        </p>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
