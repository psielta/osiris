@{
    ViewData["Title"] = "Acesso negado";
}

<div class="mx-auto flex min-h-screen w-full max-w-md items-center px-4 py-10">
    <section class="w-full rounded-lg border border-slate-200 bg-white p-6 text-center shadow-sm">
        <h1 class="text-2xl font-semibold text-slate-950">Acesso negado</h1>
        <p class="mt-2 text-sm text-slate-600">Sua conta não tem permissão para acessar esta área.</p>
        <a asp-action="Login" class="mt-6 inline-flex h-11 items-center justify-center rounded-md bg-slate-950 px-4 text-sm font-medium text-white transition hover:bg-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2">
            Entrar
        </a>
    </section>
</div>
