@model RegisterViewModel

@{
    ViewData["Title"] = "Create account";
}

<div class="mx-auto flex min-h-screen w-full max-w-lg items-center px-4 py-10">
    <section class="w-full rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
        <div>
            <div class="flex items-center gap-3">
                <img src="~/images/osiris-logo.svg" alt="Osiris" class="h-14 w-14 shrink-0" asp-append-version="true" />
                <div>
                    <p class="text-sm font-semibold uppercase tracking-wide text-emerald-700">Osiris</p>
                    <h1 class="mt-1 text-2xl font-semibold text-slate-950">Create the first tenant user</h1>
                </div>
            </div>
            <p class="mt-2 text-sm text-slate-600">Registration creates a workspace tenant and signs you in.</p>
        </div>

        <form asp-action="Register" method="post" class="mt-6 space-y-5">
            <div asp-validation-summary="ModelOnly" class="rounded-md bg-red-50 px-3 py-2 text-sm text-red-700"></div>

            <div>
                <label asp-for="TenantName" class="block text-sm font-medium text-slate-700">Workspace name</label>
                <input asp-for="TenantName" autocomplete="organization" class="mt-1 block h-11 w-full rounded-md border border-slate-300 px-3 text-sm outline-none focus:border-emerald-600 focus:ring-2 focus:ring-emerald-100" />
                <span asp-validation-for="TenantName" class="mt-1 block text-sm text-red-600"></span>
            </div>

            <div>
                <label asp-for="FullName" class="block text-sm font-medium text-slate-700">Full name</label>
                <input asp-for="FullName" autocomplete="name" class="mt-1 block h-11 w-full rounded-md border border-slate-300 px-3 text-sm outline-none focus:border-emerald-600 focus:ring-2 focus:ring-emerald-100" />
                <span asp-validation-for="FullName" class="mt-1 block text-sm text-red-600"></span>
            </div>

            <div>
                <label asp-for="Email" class="block text-sm font-medium text-slate-700"></label>
                <input asp-for="Email" type="email" autocomplete="email" class="mt-1 block h-11 w-full rounded-md border border-slate-300 px-3 text-sm outline-none focus:border-emerald-600 focus:ring-2 focus:ring-emerald-100" />
                <span asp-validation-for="Email" class="mt-1 block text-sm text-red-600"></span>
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
                <div>
                    <label asp-for="Password" class="block text-sm font-medium text-slate-700"></label>
                    <input asp-for="Password" type="password" autocomplete="new-password" class="mt-1 block h-11 w-full rounded-md border border-slate-300 px-3 text-sm outline-none focus:border-emerald-600 focus:ring-2 focus:ring-emerald-100" />
                    <span asp-validation-for="Password" class="mt-1 block text-sm text-red-600"></span>
                </div>

                <div>
                    <label asp-for="ConfirmPassword" class="block text-sm font-medium text-slate-700">Confirm password</label>
                    <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" class="mt-1 block h-11 w-full rounded-md border border-slate-300 px-3 text-sm outline-none focus:border-emerald-600 focus:ring-2 focus:ring-emerald-100" />
                    <span asp-validation-for="ConfirmPassword" class="mt-1 block text-sm text-red-600"></span>
                </div>
            </div>

            <button type="submit" class="inline-flex h-11 w-full items-center justify-center rounded-md bg-slate-950 px-4 text-sm font-medium text-white transition hover:bg-slate-800">
                Create account
            </button>
        </form>

        <p class="mt-6 text-center text-sm text-slate-600">
            Already registered?
            <a asp-action="Login" class="font-medium text-emerald-700 hover:text-emerald-800">Sign in</a>
        </p>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
