@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<h1 class="text-danger">Erro.</h1>
<h2 class="text-danger">Ocorreu um erro ao processar sua solicitação.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>ID da solicitação:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Modo de desenvolvimento</h3>
<p>
    Usar o ambiente <strong>Development</strong> exibe informações mais detalhadas sobre o erro ocorrido.
</p>
<p>
    <strong>O ambiente Development não deve ficar habilitado em aplicações publicadas.</strong>
    Ele pode exibir informações sensíveis para usuários finais.
    Para depuração local, defina a variável de ambiente <strong>ASPNETCORE_ENVIRONMENT</strong> como <strong>Development</strong>
    e reinicie o app.
</p>
