@*
    Theme toggle. Cycles light -> dark -> system, driven by the Alpine `theme` store
    (site.js). The icon and title reflect the current mode; default markup assumes
    "system" so it looks right before Alpine hydrates.
*@
<button type="button"
        x-data
        x-on:click="$store.theme.cycle()"
        x-bind:title="{ light: 'Tema: claro', dark: 'Tema: escuro', system: 'Tema: sistema' }[$store.theme.mode]"
        title="Tema: sistema"
        aria-label="Alternar tema"
        class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-slate-200 bg-white text-slate-700 transition hover:bg-slate-50 hover:text-slate-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-slate-100 dark:focus-visible:ring-offset-slate-900">
    <i class="ph ph-desktop text-xl"
       aria-hidden="true"
       x-bind:class="{ 'ph-sun': $store.theme.mode === 'light', 'ph-moon': $store.theme.mode === 'dark', 'ph-desktop': $store.theme.mode === 'system' }"></i>
</button>
