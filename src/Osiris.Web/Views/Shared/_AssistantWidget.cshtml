@*
    Floating assistant widget: a fixed bottom-right button that opens a chat panel over the layout.
    Talks to the cookie-authenticated /assistant/widget/* JSON endpoints via fetch, sending the
    antiforgery token in the RequestVerificationToken header.
*@
@inject Microsoft.Extensions.Options.IOptions<Osiris.Application.Common.AI.AiFeatureOptions> AiFeatures
@{ var voiceEnabled = AiFeatures.Value.AiAssistantVoice; }
<style>
    [x-cloak]{display:none !important;}
    .assistant-md p{margin:0;}
    .assistant-md p + p{margin-top:.4rem;}
    .assistant-md ul,.assistant-md ol{margin:.25rem 0;padding-left:1.15rem;}
    .assistant-md ul{list-style:disc;}
    .assistant-md ol{list-style:decimal;}
    .assistant-md li{margin:.1rem 0;}
    .assistant-md li::marker{color:inherit;}
    .assistant-md strong{font-weight:600;}
    .assistant-md em{font-style:italic;}
    .assistant-md a{text-decoration:underline;}
    .assistant-md code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.78rem;background:rgba(128,128,128,.22);padding:.05rem .25rem;border-radius:.25rem;}
    .assistant-md .md-h{font-weight:600;margin:.2rem 0 .1rem;}
</style>

<div x-data="assistantWidget()" x-cloak>
    @Html.AntiForgeryToken()

    <button type="button" x-show="!open" x-on:click="open = true"
            class="fixed bottom-5 right-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-amber-500 text-2xl text-white shadow-lg transition hover:bg-amber-600"
            title="Assistente financeiro" aria-label="Abrir assistente">💬</button>

    <div x-show="open" x-cloak
         class="fixed bottom-5 right-5 z-50 flex h-[34rem] max-h-[85vh] w-[22rem] max-w-[92vw] flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl dark:border-slate-700 dark:bg-slate-900">
        <header class="flex items-center justify-between border-b border-slate-200 px-4 py-3 dark:border-slate-700">
            <div>
                <p class="text-sm font-semibold text-slate-900 dark:text-slate-100">Assistente financeiro</p>
                <p class="text-[11px] text-slate-400">Respostas usam seus dados e podem conter erros.</p>
            </div>
            <div class="flex items-center gap-1">
@if (voiceEnabled)
{
                <button type="button" x-on:click="toggleVoice()" x-bind:title="voiceActive ? 'Encerrar voz' : 'Falar com o assistente'"
                        class="rounded p-1 transition"
                        x-bind:class="voiceActive ? 'text-red-500 animate-pulse' : 'text-slate-400 hover:text-amber-600'">🎤</button>
}
                <button type="button" x-on:click="reset()" title="Nova conversa"
                        class="rounded p-1 text-slate-400 transition hover:text-amber-600">＋</button>
                <button type="button" x-on:click="open = false" title="Fechar"
                        class="rounded p-1 text-slate-400 transition hover:text-slate-700 dark:hover:text-slate-200">✕</button>
            </div>
        </header>

        <div x-ref="scroll" class="flex-1 space-y-3 overflow-y-auto p-4">
            <template x-if="messages.length === 0">
                <p class="text-sm text-slate-400">Pergunte sobre suas finanças. Ex.: "Resuma minha situação deste mês".</p>
            </template>

            <template x-for="(m, i) in messages" x-bind:key="i">
                <div class="flex" x-bind:class="m.role === 'user' ? 'justify-end' : 'justify-start'">
                    <div class="assistant-md max-w-[85%] rounded-2xl px-3 py-2 text-sm leading-relaxed"
                         x-bind:class="m.role === 'user' ? 'whitespace-pre-wrap bg-amber-500 text-white' : 'bg-slate-100 text-slate-800 dark:bg-slate-800 dark:text-slate-100'"
                         x-html="render(m)"></div>
                </div>
            </template>

            <template x-for="p in proposals" x-bind:key="p.id">
                <div class="rounded-lg border border-amber-300 bg-amber-50 p-3 dark:border-amber-500/30 dark:bg-amber-500/10">
                    <p class="text-sm font-medium text-slate-900 dark:text-slate-100" x-text="p.displaySummary"></p>
                    <p class="mt-1 text-xs text-slate-600 dark:text-slate-300" x-text="p.impactSummary"></p>
                    <div class="mt-2 flex gap-2">
                        <button type="button" x-on:click="confirm(p.id)"
                                class="rounded-md bg-emerald-600 px-3 py-1 text-xs font-medium text-white transition hover:bg-emerald-700">Confirmar</button>
                        <button type="button" x-on:click="reject(p.id)"
                                class="rounded-md border border-slate-300 px-3 py-1 text-xs font-medium text-slate-700 transition hover:bg-slate-100 dark:border-slate-600 dark:text-slate-200">Rejeitar</button>
                    </div>
                </div>
            </template>

            <div x-show="sending" class="flex justify-start">
                <div class="rounded-2xl bg-slate-100 px-3 py-2 text-sm text-slate-500 dark:bg-slate-800">Pensando…</div>
            </div>

            <template x-if="voiceUser">
                <div class="flex justify-end">
                    <div class="max-w-[85%] rounded-2xl bg-amber-400/80 px-3 py-2 text-sm text-white" x-text="voiceUser"></div>
                </div>
            </template>
            <template x-if="voiceAssistant">
                <div class="flex justify-start">
                    <div class="max-w-[85%] rounded-2xl bg-slate-100 px-3 py-2 text-sm italic text-slate-600 dark:bg-slate-800 dark:text-slate-300" x-text="voiceAssistant"></div>
                </div>
            </template>
        </div>

        <template x-if="voiceActive">
            <div class="flex items-center justify-between gap-2 border-t border-amber-200 bg-amber-50 px-3 py-1.5 dark:border-amber-500/30 dark:bg-amber-500/10">
                <button type="button" x-on:click="toggleMute()"
                        x-bind:title="voiceMuted ? 'Reativar microfone' : 'Silenciar microfone'"
                        class="rounded-md px-2 py-0.5 text-[11px] font-medium transition"
                        x-bind:class="voiceMuted ? 'bg-slate-200 text-slate-600 hover:bg-slate-300 dark:bg-slate-700 dark:text-slate-300' : 'bg-amber-500 text-white hover:bg-amber-600'"
                        x-text="voiceMuted ? '🔇 Microfone desligado' : '🎙️ Microfone ligado'"></button>
                <button type="button" x-on:click="stopVoice()" title="Encerrar a sessão de voz"
                        class="rounded-md border border-red-300 px-2 py-0.5 text-[11px] font-medium text-red-600 transition hover:bg-red-50 dark:border-red-500/40 dark:text-red-400 dark:hover:bg-red-500/10">Encerrar</button>
            </div>
        </template>

        <form x-on:submit.prevent="send()" class="border-t border-slate-200 p-2 dark:border-slate-700">
            <div class="flex items-end gap-2">
                <textarea x-model="input" rows="1" maxlength="4000" placeholder="Mensagem…"
                          x-on:keydown.enter.prevent="send()"
                          class="flex-1 resize-none rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-amber-500 focus:outline-none dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"></textarea>
                <button type="submit" x-bind:disabled="sending"
                        class="rounded-md bg-amber-500 px-3 py-2 text-sm font-medium text-white transition hover:bg-amber-600 disabled:opacity-60">➤</button>
            </div>
        </form>
    </div>
</div>

<script>
    function assistantWidget() {
        return {
            open: false,
            input: '',
            sending: false,
            conversationId: null,
            messages: [],
            proposals: [],
            voiceActive: false,
            voiceMuted: false,
            voiceStatus: 'idle',
            voiceUser: '',
            voiceAssistant: '',
            voiceClient: null,
            token() {
                return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            },
            esc(s) {
                return String(s ?? '')
                    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
            },
            // Renders a safe subset of markdown. Text is HTML-escaped first, then only a fixed set of
            // tags is introduced, so the result cannot inject scripts or arbitrary HTML.
            inlineMd(t) {
                t = this.esc(t);
                t = t.replace(/`([^`]+)`/g, '<code>$1</code>');
                t = t.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
                t = t.replace(/__([^_]+)__/g, '<strong>$1</strong>');
                t = t.replace(/(^|[^*])\*([^*\n]+)\*/g, '$1<em>$2</em>');
                t = t.replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g,
                    '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>');
                return t;
            },
            renderMd(src) {
                const lines = String(src ?? '').replace(/\r\n?/g, '\n').split('\n');
                let html = '';
                let i = 0;
                while (i < lines.length) {
                    if (/^\s*$/.test(lines[i])) { i++; continue; }
                    const h = lines[i].match(/^\s*#{1,6}\s+(.*)$/);
                    if (h) { html += '<p class="md-h">' + this.inlineMd(h[1]) + '</p>'; i++; continue; }
                    if (/^\s*[-*+]\s+/.test(lines[i])) {
                        html += '<ul>';
                        while (i < lines.length && /^\s*[-*+]\s+/.test(lines[i])) {
                            html += '<li>' + this.inlineMd(lines[i].replace(/^\s*[-*+]\s+/, '')) + '</li>';
                            i++;
                        }
                        html += '</ul>';
                        continue;
                    }
                    if (/^\s*\d+[.)]\s+/.test(lines[i])) {
                        html += '<ol>';
                        while (i < lines.length && /^\s*\d+[.)]\s+/.test(lines[i])) {
                            html += '<li>' + this.inlineMd(lines[i].replace(/^\s*\d+[.)]\s+/, '')) + '</li>';
                            i++;
                        }
                        html += '</ol>';
                        continue;
                    }
                    const buf = [];
                    while (i < lines.length && !/^\s*$/.test(lines[i])
                        && !/^\s*[-*+]\s+/.test(lines[i]) && !/^\s*\d+[.)]\s+/.test(lines[i])
                        && !/^\s*#{1,6}\s+/.test(lines[i])) {
                        buf.push(lines[i]); i++;
                    }
                    html += '<p>' + this.inlineMd(buf.join('\n')).replace(/\n/g, '<br>') + '</p>';
                }
                return html;
            },
            render(m) {
                if (m.role === 'user') return this.esc(m.content).replace(/\n/g, '<br>');
                return this.renderMd(m.content);
            },
            reset() {
                this.conversationId = null;
                this.messages = [];
                this.proposals = [];
                this.input = '';
            },
            scrollDown() {
                this.$nextTick(() => { const el = this.$refs.scroll; if (el) el.scrollTop = el.scrollHeight; });
            },
            async send() {
                const text = this.input.trim();
                if (!text || this.sending) return;
                this.messages.push({ role: 'user', content: text });
                this.input = '';
                this.sending = true;
                this.scrollDown();
                try {
                    const res = await fetch('/assistant/widget/send', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': this.token() },
                        body: JSON.stringify({ conversationId: this.conversationId, message: text })
                    });
                    if (!res.ok) {
                        const err = await res.json().catch(() => ({}));
                        this.messages.push({ role: 'assistant', content: err.error || 'Não foi possível responder agora.' });
                    } else {
                        const data = await res.json();
                        this.conversationId = data.conversationId;
                        this.messages.push({ role: 'assistant', content: data.reply });
                        this.proposals = data.proposals || [];
                    }
                } catch (e) {
                    this.messages.push({ role: 'assistant', content: 'Falha de conexão com o assistente.' });
                } finally {
                    this.sending = false;
                    this.scrollDown();
                }
            },
            async confirm(id) {
                try {
                    const res = await fetch(`/assistant/widget/actions/${id}/confirm`, {
                        method: 'POST', headers: { 'RequestVerificationToken': this.token() }
                    });
                    if (res.ok) {
                        this.proposals = this.proposals.filter(p => p.id !== id);
                        this.messages.push({ role: 'assistant', content: 'Pronto! Registrei para você.' });
                    } else {
                        const err = await res.json().catch(() => ({}));
                        this.messages.push({ role: 'assistant', content: err.error || 'Não foi possível confirmar.' });
                    }
                } catch (e) {
                    this.messages.push({ role: 'assistant', content: 'Falha ao confirmar.' });
                }
                this.scrollDown();
            },
            async reject(id) {
                try {
                    await fetch(`/assistant/widget/actions/${id}/reject`, {
                        method: 'POST', headers: { 'RequestVerificationToken': this.token() }
                    });
                } catch (e) { /* ignore */ }
                this.proposals = this.proposals.filter(p => p.id !== id);
                this.scrollDown();
            },
            voiceStatusLabel() {
                const labels = {
                    connecting: 'Conectando…',
                    listening: '🎙️ Ouvindo — pode falar',
                    interrupted: '🎙️ Ouvindo — pode falar',
                    goingaway: 'Reconectando…',
                    error: 'Erro na voz',
                    closed: 'Voz encerrada'
                };
                return labels[this.voiceStatus] || 'Voz ativa';
            },
            async toggleVoice() {
                if (this.voiceActive) { this.stopVoice(); return; }
                if (!window.OsirisVoice) { return; }
                this.open = true;
                this.voiceActive = true;
                this.voiceMuted = false;
                this.voiceStatus = 'connecting';
                this.voiceUser = '';
                this.voiceAssistant = '';
                this.voiceClient = await window.OsirisVoice.create({
                    onEvent: (evt) => this.onVoiceEvent(evt),
                    onError: (msg) => {
                        this.messages.push({ role: 'assistant', content: msg });
                        this.stopVoice();
                    }
                });
            },
            onVoiceEvent(evt) {
                if (evt.type === 'status') {
                    if (evt.value === 'closed') { this.stopVoice(); return; }
                    if (evt.value === 'idle') { this.flushVoiceTurn(); return; }
                    if (evt.value === 'interrupted') { this.voiceAssistant = ''; }
                    this.voiceStatus = evt.value;
                } else if (evt.type === 'transcript') {
                    if (evt.role === 'user') { this.voiceUser += evt.text; }
                    else { this.voiceAssistant += evt.text; }
                    this.scrollDown();
                } else if (evt.type === 'proposal' && evt.proposal) {
                    this.proposals.push(evt.proposal);
                }
            },
            flushVoiceTurn() {
                const user = this.voiceUser.trim();
                const assistant = this.voiceAssistant.trim();
                // Skip transcripts that are just punctuation/noise (e.g. a lone ".").
                if (/[\p{L}\p{N}]/u.test(user)) { this.messages.push({ role: 'user', content: user }); }
                if (/[\p{L}\p{N}]/u.test(assistant)) { this.messages.push({ role: 'assistant', content: assistant }); }
                this.voiceUser = '';
                this.voiceAssistant = '';
                this.scrollDown();
            },
            toggleMute() {
                if (!this.voiceClient) { return; }
                this.voiceMuted = !this.voiceMuted;
                this.voiceClient.setMuted(this.voiceMuted);
            },
            stopVoice() {
                if (this.voiceClient) { try { this.voiceClient.stop(); } catch (e) {} this.voiceClient = null; }
                this.flushVoiceTurn();
                this.voiceActive = false;
                this.voiceMuted = false;
                this.voiceStatus = 'idle';
            }
        };
    }
</script>
@if (voiceEnabled)
{
    <script src="~/js/voice/voice-client.js" asp-append-version="true"></script>
}
