@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var activeLinkClass = "flex items-center rounded-md border-l-2 border-amber-500 bg-amber-50 px-3 py-2 text-sm font-medium text-amber-900";
    var inactiveLinkClass = "flex items-center rounded-md border-l-2 border-transparent px-3 py-2 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-950";
    var isDashboardActive = string.Equals(currentController, "Dashboard", StringComparison.OrdinalIgnoreCase);
    var isAccountsActive = string.Equals(currentController, "FinancialAccounts", StringComparison.OrdinalIgnoreCase);
    var isCreditCardsActive = string.Equals(currentController, "CreditCards", StringComparison.OrdinalIgnoreCase);
    var isCategoriesActive = string.Equals(currentController, "Categories", StringComparison.OrdinalIgnoreCase);
    var isBillsActive = string.Equals(currentController, "Bills", StringComparison.OrdinalIgnoreCase);
    var isStatementsActive = string.Equals(currentController, "Statements", StringComparison.OrdinalIgnoreCase)
        || string.Equals(currentController, "CreditCardStatements", StringComparison.OrdinalIgnoreCase);
    var isPurchasesActive = string.Equals(currentController, "Purchases", StringComparison.OrdinalIgnoreCase)
        || string.Equals(currentController, "CreditCardPurchases", StringComparison.OrdinalIgnoreCase);
    var appAssembly = typeof(Osiris.Web.Controllers.DashboardController).Assembly;
    var appVersion = System.Reflection.CustomAttributeExtensions
        .GetCustomAttribute<System.Reflection.AssemblyInformationalVersionAttribute>(appAssembly)?
        .InformationalVersion
        .Split('+')[0]
        ?? appAssembly.GetName().Version?.ToString(3)
        ?? "0.1.0";
}

<div x-show="sidebarOpen" class="fixed inset-0 z-40 bg-slate-950/40 lg:hidden" x-cloak x-on:click="sidebarOpen = false"></div>

<aside class="fixed inset-y-0 left-0 z-50 flex w-72 -translate-x-full flex-col border-r border-slate-200 bg-white transition lg:translate-x-0"
       x-bind:class="sidebarOpen ? 'translate-x-0' : '-translate-x-full lg:translate-x-0'">
    <div class="flex h-16 items-center border-b border-slate-200 px-6">
        <a asp-controller="Dashboard" asp-action="Index" class="inline-flex items-center gap-3">
            <img src="~/images/osiris-logo.svg" alt="Osiris" class="h-10 w-10 shrink-0" asp-append-version="true" />
            <span class="text-lg font-semibold text-slate-950">Osiris</span>
        </a>
    </div>

    <nav class="flex-1 space-y-1 px-3 py-4">
        <a asp-controller="Dashboard" asp-action="Index" class="@(isDashboardActive ? activeLinkClass : inactiveLinkClass)" aria-current="@(isDashboardActive ? "page" : null)">
            Painel
        </a>
        <a asp-controller="FinancialAccounts" asp-action="Index" class="@(isAccountsActive ? activeLinkClass : inactiveLinkClass)" aria-current="@(isAccountsActive ? "page" : null)">
            Contas
        </a>
        <a asp-controller="Categories" asp-action="Index" class="@(isCategoriesActive ? activeLinkClass : inactiveLinkClass)" aria-current="@(isCategoriesActive ? "page" : null)">
            Categorias
        </a>
        <a asp-controller="CreditCards" asp-action="Index" class="@(isCreditCardsActive ? activeLinkClass : inactiveLinkClass)" aria-current="@(isCreditCardsActive ? "page" : null)">
            Cartões
        </a>
        <a asp-controller="Statements" asp-action="Index" class="@(isStatementsActive ? activeLinkClass : inactiveLinkClass)" aria-current="@(isStatementsActive ? "page" : null)">
            Faturas
        </a>
        <a asp-controller="Purchases" asp-action="Index" class="@(isPurchasesActive ? activeLinkClass : inactiveLinkClass)" aria-current="@(isPurchasesActive ? "page" : null)">
            Compras no cartão
        </a>
        <a asp-controller="Bills" asp-action="Index" class="@(isBillsActive ? activeLinkClass : inactiveLinkClass)" aria-current="@(isBillsActive ? "page" : null)">
            Contas a pagar
        </a>
    </nav>

    <div class="border-t border-slate-200 px-6 py-4 text-xs font-medium text-slate-500">
        Osiris v@(appVersion)
    </div>
</aside>
