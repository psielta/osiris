@model CreditCardPurchasesIndexViewModel

@{
    ViewData["Title"] = $"Compras — {Model.Card.Name}";
    Layout = "_AuthenticatedLayout";
}

<section class="space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <p class="text-sm font-medium text-amber-700 dark:text-amber-400">Financeiro</p>
            <h2 class="mt-2 text-2xl font-semibold text-slate-950 dark:text-slate-100">Compras de @Model.Card.Name</h2>
        </div>
        <div class="flex flex-wrap gap-3">
            <a asp-controller="CreditCards" asp-action="Details" asp-route-id="@Model.Card.Id" class="inline-flex h-10 items-center justify-center rounded-md border border-slate-300 dark:border-slate-700 px-4 text-sm font-medium text-slate-700 dark:text-slate-300 transition hover:bg-slate-50 dark:hover:bg-slate-800">Voltar ao cartão</a>
            <a asp-action="Create" asp-route-cardId="@Model.Card.Id" class="inline-flex h-10 items-center justify-center rounded-md bg-slate-950 dark:bg-amber-500 dark:text-slate-950 dark:hover:bg-amber-400 px-4 text-sm font-medium text-white transition hover:bg-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2">Nova compra</a>
        </div>
    </div>

    @if (Model.Purchases.Count == 0)
    {
        <div class="rounded-lg border border-dashed border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-6 py-12 text-center shadow-sm">
            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-amber-50 dark:bg-amber-500/10 text-amber-700 dark:text-amber-400">
                <i class="ph ph-shopping-cart text-3xl" aria-hidden="true"></i>
            </div>
            <h3 class="mt-4 text-base font-semibold text-slate-950 dark:text-slate-100">Nenhuma compra registrada</h3>
            <p class="mx-auto mt-2 max-w-md text-sm text-slate-600 dark:text-slate-300">Registre as compras feitas neste cartão para acompanhar gastos por categoria e montar as faturas automaticamente.</p>
            <div class="mt-6">
                <a asp-action="Create" asp-route-cardId="@Model.Card.Id" class="inline-flex h-10 items-center justify-center rounded-md bg-slate-950 dark:bg-amber-500 dark:text-slate-950 dark:hover:bg-amber-400 px-4 text-sm font-medium text-white transition hover:bg-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2">Nova compra</a>
            </div>
        </div>
    }
    else
    {
        <div class="overflow-hidden rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
            <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-800">
                <thead class="bg-slate-50 dark:bg-slate-800">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Data</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Descrição</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Categoria</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Parcelas</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Valor total</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Ações</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 dark:divide-slate-800 bg-white dark:bg-slate-900">
                    @foreach (var purchase in Model.Purchases)
                    {
                        <tr>
                            <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-300">@purchase.PurchaseDate.ToString("dd/MM/yyyy")</td>
                            <td class="px-4 py-3 text-sm font-medium text-slate-950 dark:text-slate-100">@purchase.Description</td>
                            <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-300">@(purchase.CategoryName ?? "—")</td>
                            <td class="px-4 py-3 text-right text-sm text-slate-600 dark:text-slate-300">@(purchase.Installments)x</td>
                            <td class="px-4 py-3 text-right text-sm font-semibold text-slate-950 dark:text-slate-100">@purchase.TotalAmount.ToBrl()</td>
                            <td class="px-4 py-3 text-right">
                                <a asp-action="Details" asp-route-cardId="@Model.Card.Id" asp-route-id="@purchase.Id" class="inline-flex h-9 items-center rounded-md border border-slate-300 dark:border-slate-700 px-3 text-sm font-medium text-slate-700 dark:text-slate-300 transition hover:bg-slate-50 dark:hover:bg-slate-800">Detalhes</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
