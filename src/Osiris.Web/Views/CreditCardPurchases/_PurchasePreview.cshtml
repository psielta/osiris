@model PurchasePreviewDto?

@if (Model is null)
{
    <p class="text-sm text-slate-500 dark:text-slate-400">Preencha valor, data e parcelas para ver a prévia da compra.</p>
}
else
{
    <div class="space-y-4" data-testid="purchase-preview">
        @if (Model.HighLimitUsage)
        {
            <div class="flex items-start gap-3 rounded-md border border-amber-300 dark:border-amber-500/40 bg-amber-50 dark:bg-amber-500/10 px-4 py-3 text-sm text-amber-800 dark:text-amber-300">
                <i class="ph ph-warning-circle mt-0.5 text-lg" aria-hidden="true"></i>
                <span>Atenção: com esta compra, o cartão ficará com cerca de @Model.ProjectedUsagePercentage.ToString("0.#")% do limite usado.</span>
            </div>
        }

        <div class="grid gap-3 sm:grid-cols-3">
            <div class="rounded-md border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800 px-4 py-3">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Valor das parcelas</p>
                <p class="mt-1 text-sm font-semibold text-slate-950 dark:text-slate-100">
                    @(Model.Installments.Count)x de @Model.Installments.First().Amount.ToBrl()
                    @if (Model.Installments.Count > 1 && Model.Installments.Last().Amount != Model.Installments.First().Amount)
                    {
                        <span class="block text-xs font-normal text-slate-500 dark:text-slate-400">última de @Model.Installments.Last().Amount.ToBrl()</span>
                    }
                </p>
            </div>
            <div class="rounded-md border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800 px-4 py-3">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Limite disponível hoje</p>
                <p class="mt-1 text-sm font-semibold @(Model.AvailableLimit < 0m ? "text-red-700 dark:text-red-400" : "text-slate-950 dark:text-slate-100")">@Model.AvailableLimit.ToBrl()</p>
            </div>
            <div class="rounded-md border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800 px-4 py-3">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Parcelado futuro após a compra</p>
                <p class="mt-1 text-sm font-semibold text-slate-950 dark:text-slate-100">@Model.ProjectedFutureInstallmentsTotal.ToBrl()</p>
            </div>
        </div>

        <div class="overflow-hidden rounded-md border border-slate-200 dark:border-slate-800">
            <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-800 text-sm">
                <thead class="bg-slate-50 dark:bg-slate-800">
                    <tr>
                        <th class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Parcela</th>
                        <th class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Fatura</th>
                        <th class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Vencimento</th>
                        <th class="px-3 py-2 text-right text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Valor</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 dark:divide-slate-800 bg-white dark:bg-slate-900">
                    @foreach (var installment in Model.Installments)
                    {
                        <tr>
                            <td class="px-3 py-2 text-slate-600 dark:text-slate-300">@installment.Number de @Model.Installments.Count</td>
                            <td class="px-3 py-2 font-medium text-slate-950 dark:text-slate-100">@($"{installment.ReferenceMonth:00}/{installment.ReferenceYear}")</td>
                            <td class="px-3 py-2 text-slate-600 dark:text-slate-300">@installment.DueDate.ToString("dd/MM/yyyy")</td>
                            <td class="px-3 py-2 text-right font-medium text-slate-950 dark:text-slate-100">@installment.Amount.ToBrl()</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
