@model CreditCardPurchaseFormViewModel

@{
    ViewData["Title"] = "Nova compra";
    Layout = "_AuthenticatedLayout";
    var installmentOptions = Enumerable.Range(1, 24)
        .Select(count => new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem(
            count == 1 ? "1x (à vista)" : $"{count}x",
            count.ToString()))
        .ToArray();
}

<section class="mx-auto max-w-2xl space-y-6">
    <div>
        <p class="text-sm font-medium text-amber-700 dark:text-amber-400">Financeiro</p>
        <h2 class="mt-2 text-2xl font-semibold text-slate-950 dark:text-slate-100">Nova compra em @Model.CardName</h2>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">A compra entra na visão de gastos por categoria. O dinheiro só sai da conta quando a fatura for paga.</p>
    </div>

    <form asp-action="Create" asp-route-cardId="@Model.CardId" method="post" class="space-y-5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm">
        <div asp-validation-summary="ModelOnly" class="rounded-md bg-red-50 dark:bg-red-500/10 px-3 py-2 text-sm text-red-700 dark:text-red-400"></div>

        <div>
            <label asp-for="Description" class="block text-sm font-medium text-slate-700 dark:text-slate-300"></label>
            <input asp-for="Description" autocomplete="off" class="mt-1 block h-11 w-full rounded-md border border-slate-300 dark:border-slate-700 px-3 text-sm outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-200" />
            <span asp-validation-for="Description" class="mt-1 block text-sm text-red-600 dark:text-red-400"></span>
        </div>

        <div>
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-300">Tipo de valor informado</label>
            <div class="mt-1 inline-flex rounded-md border border-slate-300 dark:border-slate-700 p-0.5">
                <label class="cursor-pointer">
                    <input asp-for="AmountMode" type="radio" id="AmountModeTotal" value="Total" class="peer sr-only" />
                    <span class="block rounded px-3 py-1.5 text-sm font-medium text-slate-600 dark:text-slate-300 peer-checked:bg-slate-950 peer-checked:text-white dark:peer-checked:bg-amber-500 dark:peer-checked:text-slate-950">Valor total</span>
                </label>
                <label class="cursor-pointer">
                    <input asp-for="AmountMode" type="radio" id="AmountModePerInstallment" value="PerInstallment" class="peer sr-only" />
                    <span class="block rounded px-3 py-1.5 text-sm font-medium text-slate-600 dark:text-slate-300 peer-checked:bg-slate-950 peer-checked:text-white dark:peer-checked:bg-amber-500 dark:peer-checked:text-slate-950">Valor da parcela</span>
                </label>
            </div>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Escolha "Valor da parcela" para informar quanto vem em cada parcela — o total é calculado automaticamente.</p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
            <div>
                <label asp-for="TotalAmount" class="block text-sm font-medium text-slate-700 dark:text-slate-300"></label>
                <input asp-for="TotalAmount" type="number" step="0.01" min="0.01" inputmode="decimal" class="mt-1 block h-11 w-full rounded-md border border-slate-300 dark:border-slate-700 px-3 text-sm outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-200" />
                <span asp-validation-for="TotalAmount" class="mt-1 block text-sm text-red-600 dark:text-red-400"></span>
            </div>
            <div>
                <label asp-for="PurchaseDate" class="block text-sm font-medium text-slate-700 dark:text-slate-300"></label>
                <input asp-for="PurchaseDate" type="date" class="mt-1 block h-11 w-full rounded-md border border-slate-300 dark:border-slate-700 px-3 text-sm outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-200" />
                <span asp-validation-for="PurchaseDate" class="mt-1 block text-sm text-red-600 dark:text-red-400"></span>
            </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
            <div>
                <label asp-for="Installments" class="block text-sm font-medium text-slate-700 dark:text-slate-300"></label>
                <select asp-for="Installments" asp-items="installmentOptions" class="mt-1 block h-11 w-full rounded-md border border-slate-300 dark:border-slate-700 px-3 text-sm outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-200"></select>
                <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Em compras parceladas, cada parcela entra na fatura do mês correspondente.</p>
                <span asp-validation-for="Installments" class="mt-1 block text-sm text-red-600 dark:text-red-400"></span>
            </div>
            <div>
                <label asp-for="CategoryId" class="block text-sm font-medium text-slate-700 dark:text-slate-300"></label>
                <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="mt-1 block h-11 w-full rounded-md border border-slate-300 dark:border-slate-700 px-3 text-sm outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-200">
                    <option value="">Selecione a categoria</option>
                </select>
                <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Apenas categorias de despesa ativas.</p>
                <span asp-validation-for="CategoryId" class="mt-1 block text-sm text-red-600 dark:text-red-400"></span>
            </div>
        </div>

        <div>
            <label asp-for="Notes" class="block text-sm font-medium text-slate-700 dark:text-slate-300"></label>
            <textarea asp-for="Notes" rows="2" class="mt-1 block w-full rounded-md border border-slate-300 dark:border-slate-700 px-3 py-2 text-sm outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-200"></textarea>
            <span asp-validation-for="Notes" class="mt-1 block text-sm text-red-600 dark:text-red-400"></span>
        </div>

        <div class="rounded-md border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/50 p-4">
            <h3 class="text-sm font-semibold text-slate-950 dark:text-slate-100">Prévia da compra</h3>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Veja o valor de cada parcela e quais faturas serão impactadas antes de confirmar.</p>
            <div id="purchase-preview"
                 class="mt-3"
                 hx-get="@Url.Action("Preview", new { cardId = Model.CardId })"
                 hx-include="#TotalAmount, #PurchaseDate, #Installments, [name='AmountMode']"
                 hx-trigger="change from:#TotalAmount, change from:#PurchaseDate, change from:#Installments, change from:input[name='AmountMode'], keyup delay:500ms from:#TotalAmount"
                 hx-target="this">
                <p class="text-sm text-slate-500 dark:text-slate-400">Preencha valor, data e parcelas para ver a prévia da compra.</p>
            </div>
        </div>

        <div class="flex justify-end gap-3">
            <a asp-action="Index" asp-route-cardId="@Model.CardId" class="inline-flex h-10 items-center justify-center rounded-md border border-slate-300 dark:border-slate-700 px-4 text-sm font-medium text-slate-700 dark:text-slate-300 transition hover:bg-slate-50 dark:hover:bg-slate-800">Cancelar</a>
            <button type="submit" class="inline-flex h-10 items-center justify-center rounded-md bg-slate-950 dark:bg-amber-500 dark:text-slate-950 dark:hover:bg-amber-400 px-4 text-sm font-medium text-white transition hover:bg-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2">Registrar compra</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
