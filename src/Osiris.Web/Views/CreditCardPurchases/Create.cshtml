@model CreditCardPurchaseFormViewModel

@{
    ViewData["Title"] = "Nova compra";
    Layout = "_AuthenticatedLayout";
    var installmentOptions = Enumerable.Range(1, 24)
        .Select(count => new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem(
            count == 1 ? "1x (à vista)" : $"{count}x",
            count.ToString()))
        .ToArray();
}

<section class="mx-auto max-w-2xl space-y-6">
    <div>
        <p class="text-sm font-medium text-amber-700">Financeiro</p>
        <h2 class="mt-2 text-2xl font-semibold text-slate-950">Nova compra em @Model.CardName</h2>
        <p class="mt-1 text-sm text-slate-600">A compra entra na visão de gastos por categoria. O dinheiro só sai da conta quando a fatura for paga.</p>
    </div>

    <form asp-action="Create" asp-route-cardId="@Model.CardId" method="post" class="space-y-5 rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
        <div asp-validation-summary="ModelOnly" class="rounded-md bg-red-50 px-3 py-2 text-sm text-red-700"></div>

        <div>
            <label asp-for="Description" class="block text-sm font-medium text-slate-700"></label>
            <input asp-for="Description" autocomplete="off" class="mt-1 block h-11 w-full rounded-md border border-slate-300 px-3 text-sm outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-200" />
            <span asp-validation-for="Description" class="mt-1 block text-sm text-red-600"></span>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
            <div>
                <label asp-for="TotalAmount" class="block text-sm font-medium text-slate-700"></label>
                <input asp-for="TotalAmount" type="number" step="0.01" min="0.01" inputmode="decimal" class="mt-1 block h-11 w-full rounded-md border border-slate-300 px-3 text-sm outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-200" />
                <span asp-validation-for="TotalAmount" class="mt-1 block text-sm text-red-600"></span>
            </div>
            <div>
                <label asp-for="PurchaseDate" class="block text-sm font-medium text-slate-700"></label>
                <input asp-for="PurchaseDate" type="date" class="mt-1 block h-11 w-full rounded-md border border-slate-300 px-3 text-sm outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-200" />
                <span asp-validation-for="PurchaseDate" class="mt-1 block text-sm text-red-600"></span>
            </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
            <div>
                <label asp-for="Installments" class="block text-sm font-medium text-slate-700"></label>
                <select asp-for="Installments" asp-items="installmentOptions" class="mt-1 block h-11 w-full rounded-md border border-slate-300 px-3 text-sm outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-200"></select>
                <p class="mt-1 text-xs text-slate-500">Em compras parceladas, cada parcela entra na fatura do mês correspondente.</p>
                <span asp-validation-for="Installments" class="mt-1 block text-sm text-red-600"></span>
            </div>
            <div>
                <label asp-for="CategoryId" class="block text-sm font-medium text-slate-700"></label>
                <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="mt-1 block h-11 w-full rounded-md border border-slate-300 px-3 text-sm outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-200">
                    <option value="">Selecione a categoria</option>
                </select>
                <p class="mt-1 text-xs text-slate-500">Apenas categorias de despesa ativas.</p>
                <span asp-validation-for="CategoryId" class="mt-1 block text-sm text-red-600"></span>
            </div>
        </div>

        <div>
            <label asp-for="Notes" class="block text-sm font-medium text-slate-700"></label>
            <textarea asp-for="Notes" rows="2" class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-200"></textarea>
            <span asp-validation-for="Notes" class="mt-1 block text-sm text-red-600"></span>
        </div>

        <div class="flex justify-end gap-3">
            <a asp-action="Index" asp-route-cardId="@Model.CardId" class="inline-flex h-10 items-center justify-center rounded-md border border-slate-300 px-4 text-sm font-medium text-slate-700 transition hover:bg-slate-50">Cancelar</a>
            <button type="submit" class="inline-flex h-10 items-center justify-center rounded-md bg-slate-950 px-4 text-sm font-medium text-white transition hover:bg-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2">Registrar compra</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
