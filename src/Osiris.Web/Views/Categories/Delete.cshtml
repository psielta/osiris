@model CategoryEditDto

@{
    ViewData["Title"] = "Delete category";
    Layout = "_AuthenticatedLayout";
}

<section class="mx-auto max-w-2xl space-y-6">
    <div>
        <p class="text-sm font-medium text-red-700">Finance</p>
        <h2 class="mt-2 text-2xl font-semibold text-slate-950">Delete category</h2>
    </div>

    <div class="space-y-5 rounded-lg border border-red-200 bg-white p-6 shadow-sm">
        <div>
            <h3 class="text-base font-semibold text-slate-950">@Model.Name</h3>
            <p class="mt-1 text-sm text-slate-600">@Model.Type category</p>
        </div>

        <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post" class="flex justify-end gap-3">
            <a asp-action="Index" class="inline-flex h-10 items-center justify-center rounded-md border border-slate-300 px-4 text-sm font-medium text-slate-700 transition hover:bg-slate-50">Cancel</a>
            <button type="submit" class="inline-flex h-10 items-center justify-center rounded-md bg-red-700 px-4 text-sm font-medium text-white transition hover:bg-red-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2">Delete</button>
        </form>
    </div>
</section>
