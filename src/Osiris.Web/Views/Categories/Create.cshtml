@model CategoryFormViewModel

@{
    ViewData["Title"] = "Nova categoria";
    Layout = "_AuthenticatedLayout";
    var selectedColor = Model.Color ?? "#F59E0B";
    var categoryTypeOptions = CategoryTypeViewExtensions.SelectList();
}

<section class="mx-auto max-w-2xl space-y-6">
    <div>
        <p class="text-sm font-medium text-amber-700 dark:text-amber-400">Financeiro</p>
        <h2 class="mt-2 text-2xl font-semibold text-slate-950 dark:text-slate-100">Nova categoria</h2>
    </div>

    <form asp-action="Create" method="post" class="space-y-5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm">
        <div asp-validation-summary="ModelOnly" class="rounded-md bg-red-50 dark:bg-red-500/10 px-3 py-2 text-sm text-red-700 dark:text-red-400"></div>

        <div>
            <label asp-for="Name" class="block text-sm font-medium text-slate-700 dark:text-slate-300"></label>
            <input asp-for="Name" autocomplete="off" class="mt-1 block h-11 w-full rounded-md border border-slate-300 dark:border-slate-700 px-3 text-sm outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-200" />
            <span asp-validation-for="Name" class="mt-1 block text-sm text-red-600 dark:text-red-400"></span>
        </div>

        <div>
            <label asp-for="Type" class="block text-sm font-medium text-slate-700 dark:text-slate-300"></label>
            <select asp-for="Type" asp-items="categoryTypeOptions" class="mt-1 block h-11 w-full rounded-md border border-slate-300 dark:border-slate-700 px-3 text-sm outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-200">
                <option value="">Selecione o tipo</option>
            </select>
            <span asp-validation-for="Type" class="mt-1 block text-sm text-red-600 dark:text-red-400"></span>
        </div>

        <div>
            <label asp-for="Color" class="block text-sm font-medium text-slate-700 dark:text-slate-300"></label>
            <div class="mt-1 flex items-center gap-3" x-data="{ color: '@selectedColor' }">
                <input id="Color" name="Color" type="color" value="@selectedColor" x-model="color" class="h-11 w-16 cursor-pointer rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-1 outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-200" />
                <div class="flex h-11 flex-1 items-center gap-3 rounded-md border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800 px-3 text-sm text-slate-700 dark:text-slate-300">
                    <span class="h-5 w-5 rounded-full border border-slate-300 dark:border-slate-700" x-bind:style="{ backgroundColor: color }"></span>
                    <span>Cor selecionada</span>
                </div>
            </div>
            <span asp-validation-for="Color" class="mt-1 block text-sm text-red-600 dark:text-red-400"></span>
        </div>

        <div class="flex justify-end gap-3">
            <a asp-action="Index" class="inline-flex h-10 items-center justify-center rounded-md border border-slate-300 dark:border-slate-700 px-4 text-sm font-medium text-slate-700 dark:text-slate-300 transition hover:bg-slate-50 dark:hover:bg-slate-800">Cancelar</a>
            <button type="submit" class="inline-flex h-10 items-center justify-center rounded-md bg-slate-950 dark:bg-amber-500 px-4 text-sm font-medium text-white dark:text-slate-950 transition hover:bg-slate-800 dark:hover:bg-amber-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2">Criar</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
