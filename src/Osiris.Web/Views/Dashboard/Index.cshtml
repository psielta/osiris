@model DashboardVm

@{
    ViewData["Title"] = "Painel";
    Layout = "_AuthenticatedLayout";
}

<section class="space-y-6">
    <div>
        <p class="text-sm font-medium text-amber-700">Área protegida</p>
        <h2 class="mt-2 text-2xl font-semibold text-slate-950">Painel inicial</h2>
        <p class="mt-2 text-sm text-slate-600">Sua área financeira está pronta para os próximos módulos.</p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        @foreach (var metric in Model.Metrics)
        {
            <article class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
                <p class="text-sm font-medium text-slate-500">@metric.Label</p>
                <p class="mt-3 text-3xl font-semibold text-slate-950">@metric.Value</p>
                <p class="mt-2 text-sm text-slate-600">@metric.Description</p>
            </article>
        }
    </div>
</section>
