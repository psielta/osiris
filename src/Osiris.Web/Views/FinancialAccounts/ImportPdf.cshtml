@model OfxImportUploadViewModel

@{
    ViewData["Title"] = "Importar extrato PDF (IA)";
    Layout = "_AuthenticatedLayout";
}

<section class="space-y-6">
    <div>
        <p class="text-sm font-medium text-amber-700 dark:text-amber-400">Financeiro</p>
        <h2 class="mt-2 text-2xl font-semibold text-slate-950 dark:text-slate-100">Importar extrato PDF (IA)</h2>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Conta: @Model.AccountName</p>
    </div>

    <form asp-action="ImportPdfPreview" asp-route-id="@Model.AccountId" method="post" enctype="multipart/form-data" class="space-y-5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm">
        <div asp-validation-summary="All" class="rounded-md bg-red-50 dark:bg-red-500/10 px-3 py-2 text-sm text-red-700 dark:text-red-400"></div>

        <div>
            <label for="file" class="block text-sm font-medium text-slate-700 dark:text-slate-300">Arquivo PDF</label>
            <input type="file" id="file" name="file" accept=".pdf,application/pdf"
                   class="mt-1 block w-full rounded-md border border-slate-300 dark:border-slate-700 px-3 py-2 text-sm text-slate-700 dark:text-slate-300 outline-none file:mr-4 file:rounded-md file:border-0 file:bg-slate-100 dark:file:bg-slate-800 file:px-3 file:py-2 file:text-sm file:font-medium file:text-slate-700 dark:file:text-slate-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-200" />
            <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">Selecione o <strong>PDF</strong> do extrato do seu banco (até 15 MB). A <strong>inteligência artificial</strong> vai ler o arquivo e extrair os lançamentos para você revisar antes de confirmar. Isso pode levar alguns segundos.</p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <a asp-action="Details" asp-route-id="@Model.AccountId" class="inline-flex h-10 items-center justify-center rounded-md border border-slate-300 dark:border-slate-700 px-4 text-sm font-medium text-slate-700 dark:text-slate-300 transition hover:bg-slate-50 dark:hover:bg-slate-800">Cancelar</a>
            <button type="submit" id="pdfSubmit" data-busy="Processando com IA…" class="inline-flex h-10 items-center justify-center gap-2 rounded-md bg-slate-950 dark:bg-amber-500 px-4 text-sm font-medium text-white dark:text-slate-950 transition hover:bg-slate-800 dark:hover:bg-amber-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2">Processar com IA</button>
        </div>
    </form>
</section>

@section Scripts {
    <script>
        (function () {
            var form = document.querySelector('form');
            var button = document.getElementById('pdfSubmit');
            if (!form || !button) return;
            form.addEventListener('submit', function () {
                button.disabled = true;
                button.textContent = button.getAttribute('data-busy');
            });
        })();
    </script>
}
