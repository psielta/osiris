@model PurchasesIndexViewModel

@{
    ViewData["Title"] = "Compras no cartão";
    Layout = "_AuthenticatedLayout";
    var currentMonthButtonClasses = Model.Filter.IsCurrentMonth
        ? "border-amber-500 bg-amber-50 text-amber-800 dark:border-amber-500/50 dark:bg-amber-500/10 dark:text-amber-300"
        : "border-slate-300 text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800";
    var nextMonthButtonClasses = Model.Filter.IsNextMonth
        ? "border-amber-500 bg-amber-50 text-amber-800 dark:border-amber-500/50 dark:bg-amber-500/10 dark:text-amber-300"
        : "border-slate-300 text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800";
}

<section class="space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <p class="text-sm font-medium text-amber-700 dark:text-amber-400">Financeiro</p>
            <h2 class="mt-2 text-2xl font-semibold text-slate-950 dark:text-slate-100">Compras no cartão</h2>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Todas as compras dos seus cartões. Para registrar uma nova compra, abra o cartão.</p>
        </div>
        <a asp-controller="CreditCards" asp-action="Index" class="inline-flex h-10 items-center justify-center rounded-md border border-slate-300 dark:border-slate-700 px-4 text-sm font-medium text-slate-700 dark:text-slate-300 transition hover:bg-slate-50 dark:hover:bg-slate-800">
            Ver cartões
        </a>
    </div>

    <div class="rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-sm">
        <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Período por data da compra</p>
                <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">@Model.Filter.Label</p>
            </div>
            <div class="flex flex-col gap-3 md:flex-row md:items-end">
                <div class="flex flex-wrap gap-2">
                    <a asp-action="Index" asp-route-from="@Model.Filter.CurrentMonthFromIso" asp-route-to="@Model.Filter.CurrentMonthToIso" class="inline-flex h-10 items-center rounded-md border px-3 text-sm font-medium transition @currentMonthButtonClasses">
                        Mês atual
                    </a>
                    <a asp-action="Index" asp-route-from="@Model.Filter.NextMonthFromIso" asp-route-to="@Model.Filter.NextMonthToIso" class="inline-flex h-10 items-center rounded-md border px-3 text-sm font-medium transition @nextMonthButtonClasses">
                        Próximo mês
                    </a>
                </div>
                <form asp-action="Index" method="get" class="flex flex-wrap items-end gap-2">
                    <div>
                        <label for="from" class="block text-xs font-medium text-slate-600 dark:text-slate-300">De</label>
                        <input id="from" name="from" type="date" value="@Model.Filter.FromIso" class="mt-1 h-10 rounded-md border border-slate-300 dark:border-slate-700 px-3 text-sm outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-200" />
                    </div>
                    <div>
                        <label for="to" class="block text-xs font-medium text-slate-600 dark:text-slate-300">Até</label>
                        <input id="to" name="to" type="date" value="@Model.Filter.ToIso" class="mt-1 h-10 rounded-md border border-slate-300 dark:border-slate-700 px-3 text-sm outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-200" />
                    </div>
                    <button type="submit" class="inline-flex h-10 items-center justify-center rounded-md border border-slate-300 dark:border-slate-700 px-4 text-sm font-medium text-slate-700 dark:text-slate-300 transition hover:bg-slate-50 dark:hover:bg-slate-800">
                        Filtrar
                    </button>
                </form>
            </div>
        </div>
    </div>

    @if (Model.Purchases.Count == 0)
    {
        <div class="rounded-lg border border-dashed border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-6 py-12 text-center shadow-sm">
            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-amber-50 dark:bg-amber-500/10 text-amber-700 dark:text-amber-400">
                <i class="ph ph-shopping-cart text-3xl" aria-hidden="true"></i>
            </div>
            <h3 class="mt-4 text-base font-semibold text-slate-950 dark:text-slate-100">Nenhuma compra registrada neste período</h3>
            <p class="mx-auto mt-2 max-w-md text-sm text-slate-600 dark:text-slate-300">Não há compras entre @Model.Filter.Label. Abra um cartão para registrar a primeira compra. Compras parceladas geram parcelas nas faturas seguintes.</p>
            <div class="mt-6">
                <a asp-controller="CreditCards" asp-action="Index" class="inline-flex h-10 items-center justify-center rounded-md bg-slate-950 dark:bg-amber-500 dark:text-slate-950 dark:hover:bg-amber-400 px-4 text-sm font-medium text-white transition hover:bg-slate-800">Ir para cartões</a>
            </div>
        </div>
    }
    else
    {
        <div class="overflow-hidden rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
            <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-800">
                <thead class="bg-slate-50 dark:bg-slate-800">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Data</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Descrição</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Cartão</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Categoria</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Parcelas</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Valor</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 dark:divide-slate-800 bg-white dark:bg-slate-900">
                    @foreach (var purchase in Model.Purchases)
                    {
                        <tr>
                            <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-300">@purchase.PurchaseDate.ToString("dd/MM/yyyy")</td>
                            <td class="px-4 py-3 text-sm font-medium text-slate-950 dark:text-slate-100">
                                <a asp-controller="CreditCardPurchases" asp-action="Details" asp-route-cardId="@purchase.CreditCardId" asp-route-id="@purchase.Id" class="hover:text-amber-700">@purchase.Description</a>
                            </td>
                            <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-300">@purchase.CreditCardName</td>
                            <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-300">@(purchase.CategoryName ?? "—")</td>
                            <td class="px-4 py-3 text-right text-sm text-slate-600 dark:text-slate-300">@(purchase.Installments)x</td>
                            <td class="px-4 py-3 text-right text-sm font-semibold text-slate-950 dark:text-slate-100">@purchase.TotalAmount.ToBrl()</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
