@model DocumentationIndexViewModel

@{
    ViewData["Title"] = "Documentacao";
    Layout = "_AuthenticatedLayout";
    var groups = Model.Items
        .GroupBy(item => item.Group)
        .OrderBy(group => group.Key)
        .ToArray();
}

<section class="space-y-6">
    <div>
        <p class="text-sm font-medium text-amber-700">Ajuda</p>
        <h2 class="mt-2 text-2xl font-semibold text-slate-950">Documentacao do Osiris</h2>
        <p class="mt-2 max-w-2xl text-sm text-slate-600">Guias simples para usar cada area do sistema no dia a dia.</p>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="rounded-lg border border-dashed border-slate-300 bg-white px-6 py-12 text-center shadow-sm">
            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-slate-50 text-slate-500">
                <i class="ph ph-file-text text-3xl" aria-hidden="true"></i>
            </div>
            <h3 class="mt-4 text-base font-semibold text-slate-950">Nenhum guia cadastrado</h3>
            <p class="mx-auto mt-2 max-w-md text-sm text-slate-600">Quando novas telas forem documentadas, elas aparecerao aqui.</p>
        </div>
    }
    else
    {
        <div class="space-y-6">
            @foreach (var group in groups)
            {
                <div class="space-y-3">
                    <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500">@group.Key</h3>
                    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                        @foreach (var item in group.OrderBy(item => item.Order).ThenBy(item => item.Title))
                        {
                            <a asp-controller="Docs" asp-action="Show" asp-route-slug="@item.Slug" class="group rounded-lg border border-slate-200 bg-white p-5 shadow-sm transition hover:border-amber-300 hover:shadow">
                                <div class="flex items-start gap-4">
                                    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-md bg-amber-50 text-amber-700 transition group-hover:bg-amber-100">
                                        <i class="@item.Icon text-2xl" aria-hidden="true"></i>
                                    </div>
                                    <div>
                                        <h4 class="text-sm font-semibold text-slate-950">@item.Title</h4>
                                        <p class="mt-1 text-sm text-slate-600">@item.Description</p>
                                    </div>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    }
</section>
