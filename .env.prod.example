POSTGRES_USER=osiris
POSTGRES_PASSWORD=replace-with-hex-password
POSTGRES_DB=osiris_prod

# JWT signing key for the mobile API (HS256). Generate with: openssl rand -hex 32
JWT_SIGNING_KEY=replace-with-hex-signing-key

ASPNETCORE_ENVIRONMENT=Production
DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false
TZ=America/Sao_Paulo
