POSTGRES_USER=osiris
POSTGRES_PASSWORD=replace-with-hex-password
POSTGRES_DB=osiris_prod

# JWT signing key for the mobile API (HS256). Generate with: openssl rand -hex 32
JWT_SIGNING_KEY=replace-with-hex-signing-key

# Gemini API key for PDF statement import (AI extraction) and the AI assistant chat.
# Get one at https://aistudio.google.com/apikey
# Optional: if absent, PDF import and the assistant fail gracefully; the rest of the app keeps working.
GEMINI_API_KEY=replace-with-gemini-api-key

# AI assistant (chat). Requires GEMINI_API_KEY. Off by default; turn on per environment.
# Writes lets the assistant create confirmable proposals (it never writes without user confirmation).
AI_ASSISTANT_ENABLED=false
AI_ASSISTANT_WRITES=false
# Voice agent (Gemini Live API over WebSocket). Requires AI_ASSISTANT_ENABLED + GEMINI_API_KEY. Preview.
AI_ASSISTANT_VOICE=false
# Optional override of the Live model id (default verified working). Swap without a redeploy if Google moves it.
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

ASPNETCORE_ENVIRONMENT=Production
DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false
TZ=America/Sao_Paulo
